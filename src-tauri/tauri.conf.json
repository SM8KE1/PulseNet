{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "PulseNet",
  "version": "1.6.2",
  "identifier": "com.pulsenet.app",
  "build": {
    "beforeDevCommand": "npm run dev:ui",
    "beforeBuildCommand": "npm run build:ui",
    "devUrl": "http://127.0.0.1:5173",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "PulseNet",
        "width": 1100,
        "height": 680,
        "minWidth": 900,
        "minHeight": 560,
        "decorations": false,
        "transparent": true,
        "resizable": true,
        "fullscreen": false,
        "maximized": false
      }
    ],
    "security": {
      "csp": null
    },
    "trayIcon": {
      "id": "main",
      "iconPath": "icons/icon.ico",
      "iconAsTemplate": false
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "windows": {
      "nsis": {
        "template": "nsis-template.nsi",
        "installMode": "perMachine"
      },
      "wix": {
        "fragmentPaths": [
          "wix/legacy-nsis-cleanup.wxs"
        ],
        "componentGroupRefs": [
          "LegacyNsisCleanupGroup"
        ]
      }
    },
    "linux": {
      "deb": {
        "depends": [
          "libayatana-appindicator3-1",
          "libcap2-bin",
          "libwebkit2gtk-4.1-0",
          "network-manager",
          "nftables"
        ],
        "postInstallScript": "scripts/linux-postinstall.sh",
        "preRemoveScript": "scripts/linux-preremove.sh"
      },
      "rpm": {
        "depends": [
          "libcap",
          "NetworkManager",
          "nftables",
          "webkit2gtk4.1"
        ],
        "postInstallScript": "scripts/linux-postinstall.sh",
        "preRemoveScript": "scripts/linux-preremove.sh"
      }
    },
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/256x256.png",
      "icons/icon.ico"
    ]
  }
}
