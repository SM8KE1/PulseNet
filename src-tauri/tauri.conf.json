{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "PulseNet",
  "version": "1.6.1",
  "identifier": "com.pulsenet.app",
  "build": {
    "beforeDevCommand": "npm run dev:ui",
    "beforeBuildCommand": "npm run build:ui",
    "devUrl": "http://127.0.0.1:5173",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "PulseNet",
        "width": 1000,
        "height": 600,
        "decorations": false,
        "transparent": true,
        "resizable": false,
        "fullscreen": false,
        "maximized": false
      }
    ],
    "security": {
      "csp": null
    },
    "trayIcon": {
      "id": "main",
      "iconPath": "icons/icon.ico",
      "iconAsTemplate": false
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "windows": {
      "nsis": {
        "template": "nsis-template.nsi"
      },
      "wix": {
        "fragmentPaths": [
          "wix/legacy-nsis-cleanup.wxs"
        ],
        "componentGroupRefs": [
          "LegacyNsisCleanupGroup"
        ]
      }
    },
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.ico"
    ]
  }
}
