<?xml version="1.0" encoding="UTF-8"?>
<Wix xmlns="http://schemas.microsoft.com/wix/2006/wi">
  <Fragment>
    <DirectoryRef Id="INSTALLDIR">
      <Component Id="LegacyNsisCleanupAnchor" Guid="*">
        <RegistryValue
          Root="HKCU"
          Key="Software\pulsenet\PulseNet"
          Name="LegacyNsisCleanupAnchor"
          Type="integer"
          Value="1"
          KeyPath="yes"
        />
      </Component>
    </DirectoryRef>

    <ComponentGroup Id="LegacyNsisCleanupGroup">
      <ComponentRef Id="LegacyNsisCleanupAnchor" />
    </ComponentGroup>

    <Property Id="OLD_NSIS_UNINSTALL_HKLM64">
      <RegistrySearch
        Id="OldNsisUninstallHKLM64"
        Root="HKLM"
        Key="Software\Microsoft\Windows\CurrentVersion\Uninstall\PulseNet"
        Name="UninstallString"
        Type="raw"
        Win64="yes"
      />
    </Property>

    <Property Id="OLD_NSIS_UNINSTALL_HKLM32">
      <RegistrySearch
        Id="OldNsisUninstallHKLM32"
        Root="HKLM"
        Key="Software\Microsoft\Windows\CurrentVersion\Uninstall\PulseNet"
        Name="UninstallString"
        Type="raw"
        Win64="no"
      />
    </Property>

    <Property Id="OLD_NSIS_UNINSTALL_HKCU64">
      <RegistrySearch
        Id="OldNsisUninstallHKCU64"
        Root="HKCU"
        Key="Software\Microsoft\Windows\CurrentVersion\Uninstall\PulseNet"
        Name="UninstallString"
        Type="raw"
        Win64="yes"
      />
    </Property>

    <Property Id="OLD_NSIS_UNINSTALL_HKCU32">
      <RegistrySearch
        Id="OldNsisUninstallHKCU32"
        Root="HKCU"
        Key="Software\Microsoft\Windows\CurrentVersion\Uninstall\PulseNet"
        Name="UninstallString"
        Type="raw"
        Win64="no"
      />
    </Property>

    <CustomAction
      Id="UninstallOldNsisHKLM64"
      Directory="TARGETDIR"
      ExeCommand='[OLD_NSIS_UNINSTALL_HKLM64] /S'
      Execute="immediate"
      Return="check"
      Impersonate="no"
    />

    <CustomAction
      Id="UninstallOldNsisHKLM32"
      Directory="TARGETDIR"
      ExeCommand='[OLD_NSIS_UNINSTALL_HKLM32] /S'
      Execute="immediate"
      Return="check"
      Impersonate="no"
    />

    <CustomAction
      Id="UninstallOldNsisHKCU64"
      Directory="TARGETDIR"
      ExeCommand='[OLD_NSIS_UNINSTALL_HKCU64] /S'
      Execute="immediate"
      Return="check"
      Impersonate="yes"
    />

    <CustomAction
      Id="UninstallOldNsisHKCU32"
      Directory="TARGETDIR"
      ExeCommand='[OLD_NSIS_UNINSTALL_HKCU32] /S'
      Execute="immediate"
      Return="check"
      Impersonate="yes"
    />

    <CustomAction
      Id="LaunchPulseNetFromFinish"
      Directory="INSTALLDIR"
      ExeCommand='cmd.exe /C start "" "[#Path]"'
      Execute="immediate"
      Return="asyncNoWait"
      Impersonate="yes"
    />

    <InstallExecuteSequence>
      <Custom Action="UninstallOldNsisHKLM64" Before="InstallInitialize">
        NOT Installed AND NOT REMOVE AND OLD_NSIS_UNINSTALL_HKLM64
      </Custom>
      <Custom Action="UninstallOldNsisHKLM32" Before="InstallInitialize">
        NOT Installed AND NOT REMOVE AND OLD_NSIS_UNINSTALL_HKLM32 AND NOT OLD_NSIS_UNINSTALL_HKLM64
      </Custom>
      <Custom Action="UninstallOldNsisHKCU64" Before="InstallInitialize">
        NOT Installed AND NOT REMOVE AND OLD_NSIS_UNINSTALL_HKCU64
      </Custom>
      <Custom Action="UninstallOldNsisHKCU32" Before="InstallInitialize">
        NOT Installed AND NOT REMOVE AND OLD_NSIS_UNINSTALL_HKCU32 AND NOT OLD_NSIS_UNINSTALL_HKCU64
      </Custom>
    </InstallExecuteSequence>

    <UI>
      <Publish Dialog="ExitDialog" Control="Finish" Event="DoAction" Value="LaunchPulseNetFromFinish">
        WIXUI_EXITDIALOGOPTIONALCHECKBOX = 1 AND NOT Installed
      </Publish>
    </UI>
  </Fragment>
</Wix>
